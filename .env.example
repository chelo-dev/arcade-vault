# Copia este archivo a .env.local y completa los valores.
# Nunca uses el prefijo NEXT_PUBLIC_ en estas variables: son solo de servidor.

# Clave de API de Resend (https://resend.com/api-keys). Obligatoria.
RESEND_API_KEY=

# Destinatario de los mensajes de contacto. Obligatoria.
# Con el remitente de pruebas onboarding@resend.dev, Resend solo entrega
# al correo de la cuenta de Resend: usa ese correo hasta verificar un dominio.
CONTACT_TO_EMAIL=

# Remitente. Opcional; por defecto onboarding@resend.dev.
# CONTACT_FROM_EMAIL=Arcade Vault <contacto@tu-dominio.com>

# Supabase. Ambas son públicas (llegan al navegador) y obligatorias.
# Se obtienen en Project Settings → API del dashboard de Supabase.

# URL del proyecto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Clave publicable (sb_publishable_...). Nunca pongas aquí la clave service_role
# ni la contraseña de Postgres.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
